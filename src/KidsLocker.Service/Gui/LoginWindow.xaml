<Window x:Class="KidsLocker.Service.Gui.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KidsLocker" Width="420" SizeToContent="Height" FontSize="14"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="28,20,28,24">
        <Border Width="48" Height="48" CornerRadius="24" HorizontalAlignment="Left"
                Background="{DynamicResource AccentFillColorDefaultBrush}">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="22" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        </Border>

        <TextBlock x:Name="Heading" Margin="0,16,0,4" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="Subheading" Style="{StaticResource Hint}" FontSize="14" />

        <TextBlock Text="Пароль" Margin="0,20,0,6" />
        <PasswordBox x:Name="Pass1" AutomationProperties.Name="Пароль" />

        <StackPanel x:Name="RepeatPanel" Visibility="Collapsed">
            <TextBlock Text="Повтор" Margin="0,12,0,6" />
            <PasswordBox x:Name="Pass2" AutomationProperties.Name="Повтор пароля" />
        </StackPanel>

        <StackPanel x:Name="ErrorPanel" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE783;" FontSize="14" VerticalAlignment="Top" Margin="0,2,8,0"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" MaxWidth="330"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="OkButton" MinWidth="110" IsDefault="True"
                    Style="{DynamicResource AccentButtonStyle}" Click="OnOk" />
            <Button Content="Отмена" MinWidth="110" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
