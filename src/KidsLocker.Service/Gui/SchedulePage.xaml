<UserControl x:Class="KidsLocker.Service.Gui.SchedulePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gui="clr-namespace:KidsLocker.Service.Gui">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,4,28,24" MaxWidth="860">
            <TextBlock Text="Расписание" Style="{StaticResource PageTitle}" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Контроль включён" />
                            <TextBlock Style="{StaticResource Hint}" Text="Вне разрешённых часов компьютер выключается" />
                        </StackPanel>
                        <CheckBox x:Name="Enabled" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                  AutomationProperties.Name="Контроль включён" Click="OnEnabledClick" />
                    </Grid>
                    <gui:InfoBar x:Name="EnabledInfo" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Разрешённое время" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,12"
                               Text="Несколько отрезков — через запятую: 07:00-12:00, 14:00-23:00. 24:00 — полночь." />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <gui:HourScale Grid.Column="2" Margin="16,0,0,0" />
                    </Grid>

                    <ItemsControl x:Name="Days" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type gui:DayRow}">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                             AutomationProperties.AutomationId="{Binding AutomationId}"
                                             AutomationProperties.Name="{Binding FullName}"
                                             AutomationProperties.HelpText="{Binding Note}" />
                                    <Grid Grid.Column="2" Margin="16,0,0,0">
                                        <gui:DayTimeline x:Name="Timeline" Height="8" VerticalAlignment="Center"
                                                         Intervals="{Binding Intervals}" />
                                        <DockPanel x:Name="NotePanel" VerticalAlignment="Center" Visibility="Collapsed">
                                            <TextBlock x:Name="NoteIcon" DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE783;"
                                                       FontSize="12" Margin="0,2,6,0" VerticalAlignment="Top" Visibility="Collapsed"
                                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                            <TextBlock x:Name="NoteText" Text="{Binding Note}" FontSize="12" TextWrapping="Wrap"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </DockPanel>
                                    </Grid>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="BlockedAllDay">
                                        <Setter TargetName="Timeline" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="NotePanel" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Error">
                                        <Setter TargetName="Timeline" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="NotePanel" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="NoteIcon" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="NoteText" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button x:Name="SaveButton" Content="Сохранить расписание"
                                Style="{DynamicResource AccentButtonStyle}" Click="OnSave" />
                        <TextBlock x:Name="SaveHint" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <gui:InfoBar x:Name="SaveInfo" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="NowBadge" CornerRadius="4" Padding="8,2">
                            <TextBlock x:Name="NowText" />
                        </Border>
                        <TextBlock x:Name="NowDetails" Style="{StaticResource Hint}" FontSize="13" Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="PauseButton" Content="Пауза 2 часа" Margin="0,0,8,8" Click="OnPause" />
                        <Button x:Name="ResumeButton" Content="Снять паузу" Margin="0,0,8,8" Click="OnResume" />
                        <Button x:Name="ExtraButton" Content="+1 час сегодня" Margin="0,0,8,8" Click="OnExtraHour" />
                        <Button x:Name="ShutdownButton" Content="Выключить сейчас" Margin="0,0,8,8"
                                Style="{StaticResource DangerButton}" Click="OnShutdown" />
                    </WrapPanel>
                    <gui:InfoBar x:Name="ActionInfo" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
