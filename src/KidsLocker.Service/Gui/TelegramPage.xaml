<UserControl x:Class="KidsLocker.Service.Gui.TelegramPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gui="clr-namespace:KidsLocker.Service.Gui">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,4,28,24" MaxWidth="860">
            <TextBlock Text="Telegram" Style="{StaticResource PageTitle}" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Токен бота (@BotFather)" Margin="0,0,0,6" />
                    <TextBox x:Name="Token" AutomationProperties.Name="Токен бота" />

                    <TextBlock Text="Ваш chat_id" Margin="0,16,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="ChatId" Width="220" AutomationProperties.Name="chat_id" />
                        <Button x:Name="DetectButton" Content="Определить автоматически" Margin="8,0,0,0" Click="OnDetect" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="Сначала напишите своему боту любое сообщение, потом нажмите «Определить»." />

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button x:Name="TestButton" Content="Проверить связь" Click="OnTest" />
                        <Button x:Name="SaveButton" Content="Сохранить" Margin="8,0,0,0"
                                Style="{DynamicResource AccentButtonStyle}" Click="OnSave" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <gui:InfoBar x:Name="Status" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
