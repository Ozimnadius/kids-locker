<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>KidsLocker.Service</RootNamespace>
    <AssemblyName>KidsLocker</AssemblyName>
    <LangVersion>latest</LangVersion>

    <!-- Одно приложение: двойной щелчок открывает пульт; тот же exe работает и как служба. -->
    <OutputType>WinExe</OutputType>
    <!-- Пульт — WPF со встроенной темой Fluent: светлая/тёмная тема и акцентный цвет берутся из Windows. -->
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Поставка: один самодостаточный exe, на целевом ПК среда .NET не нужна -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- System.Diagnostics.EventLog входит в общий фреймворк Microsoft.WindowsDesktop.App,
       отдельная ссылка на пакет не нужна (SDK 10 предупреждает об этом: NU1510). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.EventLog" Version="10.0.14" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Setup/GitHubRecovery.ps1" LogicalName="KidsLocker.GitHubRecovery.ps1" />
    <!-- Для WPF-проектов SDK не подключает System.IO и System.Net.Http неявно (у WPF есть свой Path),
         а код службы на них опирается. Возвращаем прежний набор. -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

</Project>
