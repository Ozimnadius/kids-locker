<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>KidsLocker.Service</RootNamespace>
    <AssemblyName>KidsLocker</AssemblyName>
    <LangVersion>latest</LangVersion>

    <!-- One app: double-click opens the GUI; the same exe also runs as the service. -->
    <OutputType>WinExe</OutputType>
    <!-- Пульт — WPF со встроенной темой Fluent: светлая/тёмная тема и акцентный цвет берутся из Windows. -->
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Deployment: one self-contained exe, no .NET runtime needed on the target PC -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- System.Diagnostics.EventLog в .NET 10 входит во фреймворк Windows Desktop — отдельный пакет не нужен. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.EventLog" Version="10.0.14" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- Для WPF-проектов SDK не подключает System.IO и System.Net.Http неявно (у WPF есть свой Path),
         а код службы на них опирается. Возвращаем прежний набор. -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

</Project>
